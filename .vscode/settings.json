{
  "go.formatTool": "custom",
  "go.alternateTools": {
    "customFormatter": "golines"
  },
  "go.formatFlags": ["-m", "120", "--base-formatter=gofmt"],
  "[go]": {
    "editor.formatOnSave": true
  },
  "gopls": {
    "build.directoryFilters": ["-worktrees", "-.worktrees"]
  },
  "files.exclude": {
    "**/worktrees/**": true,
    "**/.worktrees/**": true
  },
  "files.watcherExclude": {
    "**/worktrees/**": true,
    "**/.worktrees/**": true
  },
  "search.exclude": {
    "**/worktrees/**": true,
    "**/.worktrees/**": true
  }
}
