# Gateway host — public HTTP front. Loaded by koanf in addition to
# appsettings.json: env vars override file values when the key follows the
# UPPER_SNAKE pattern with `__` between sections (lowercased + `__` -> `.`).

GATEWAY_HOST__API_PORT=5000
GATEWAY_HOST__BODY_LIMIT_BYTES=4194304 # Default: 4194304 (4MB)

RATE_LIMIT__REQUESTS_PER_SECOND=50 # Default: 50, per client IP
PROXY__HEADER= # optional, e.g. X-Forwarded-For; honored only from PROXY__TRUSTED_PROXIES
PROXY__TRUSTED_PROXIES= # optional, comma-separated IPs or CIDR ranges; the Docker image trusts 127.0.0.1 + private ranges, keep 127.0.0.1 when overriding

TELEMETRY__ENABLED=false
# grpc (default) or http; endpoint stays host:port (collector 4317 for grpc, 4318 for http).
TELEMETRY__PROTOCOL=
TELEMETRY__ENDPOINT=
TELEMETRY__INSECURE=
TELEMETRY__INSTANCE_ID=
TELEMETRY__ENVIRONMENT=
TELEMETRY__AUTH_TOKEN=
TELEMETRY__AUTH_USERNAME=
TELEMETRY__AUTH_PASSWORD=

JWT__SIGNING_KEY=
JWT__TOKEN_TTL=1800
JWT__NONCE_TTL=300
JWT__REFRESH_TTL=604800
JWT__REFRESH_IDLE_TTL=86400

CONSOLE__URL=http://localhost:5500 # Required: the console's public URL

CORS__ALLOW_ORIGINS= # optional, comma-separated, defaults to the CONSOLE__URL origin; * allows any

SIWE__STATEMENT= # optional, has a default

RUNTIME_CLIENT__BASE_URL=http://127.0.0.1:5400
AGENT_IDENTITY__RUNTIME_URL=