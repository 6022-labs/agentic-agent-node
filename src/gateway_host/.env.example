# Gateway host — public HTTP front. Loaded by koanf in addition to
# appsettings.json: env vars override file values when the key follows the
# UPPER_SNAKE pattern with `__` between sections (lowercased + `__` -> `.`).

GATEWAY_HOST__API_PORT=5000
GATEWAY_HOST__BODY_LIMIT_BYTES=4194304 # Default: 4194304 (4MB)

TELEMETRY__ENABLED=false
TELEMETRY__ENDPOINT=
TELEMETRY__INSECURE=
TELEMETRY__NODE_ID=

JWT__SIGNING_KEY=
JWT__TOKEN_TTL=1800
JWT__NONCE_TTL=300

SIWE__URI=http://localhost:5500
SIWE__STATEMENT= # optional, has a default

RUNTIME_CLIENT__BASE_URL=http://127.0.0.1:5400
AGENT_IDENTITY__RUNTIME_URL=