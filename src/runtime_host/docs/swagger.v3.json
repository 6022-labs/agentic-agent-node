                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/responses.GetBootstrapStatusResponse"
                                }
                            }
                        },
                        "description": "OK"
                    }
                },
                "summary": "Internal bootstrap status",
                "tags": [
                    "Internal"
                ]
            }
        },
