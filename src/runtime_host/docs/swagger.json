{
    "swagger": "2.0",
    "info": {
        "description": "Internal-only runtime + knowledge surface. Bound to 127.0.0.1; only gateway_host calls it. All endpoints are mounted under /internal.",
        "title": "Agentic Agent Node — Runtime Host API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/internal/agent/registration": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Internal"
                ],
                "summary": "Get agent registration draft",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.AgentRegistrationResponse"
                        }
                    },
                    "404": {
                        "description": "draft_not_found",
                        "schema": {
                            "$ref": "#/definitions/fiber.Map"
                        }
                    }
                }
            },
            "post": {
                "description": "Validates the collection + form and binds the draft to the node wallet. Returns the stored draft + status.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Internal"
                ],
                "summary": "Save agent registration draft",
                "parameters": [
                    {
                        "description": "Agent draft",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/requests.SaveAgentRegistrationRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.AgentRegistrationResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/errors.ValidationError"
                        }
                    }
                }
            }
        },
        "/internal/agent/registration/ens-info": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Internal"
                ],
                "summary": "Get ENS calldata",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.EnsInfoResponse"
                        }
                    },
                    "409": {
                        "description": "not_minted",
                        "schema": {
                            "$ref": "#/definitions/fiber.Map"
                        }
                    }
                }
            }
        },
        "/internal/agent/registration/ens/check": {
            "post": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Internal"
                ],
                "summary": "Check ENS status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.RegistrationStatusResponse"
                        }
                    },
                    "409": {
                        "description": "not_minted",
                        "schema": {
                            "$ref": "#/definitions/fiber.Map"
                        }
                    }
                }
            }
        },
        "/internal/agent/registration/mint-info": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Internal"
                ],
                "summary": "Get mint calldata",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.MintInfoResponse"
                        }
                    },
                    "404": {
                        "description": "draft_not_found",
                        "schema": {
                            "$ref": "#/definitions/fiber.Map"
                        }
                    }
                }
            }
        },
        "/internal/agent/registration/mint/check": {
            "post": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Internal"
                ],
                "summary": "Check mint status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.RegistrationStatusResponse"
                        }
                    },
                    "404": {
                        "description": "draft_not_found",
                        "schema": {
                            "$ref": "#/definitions/fiber.Map"
                        }
                    }
                }
            }
        },
        "/internal/agent/registration/self": {
            "post": {
                "description": "Uses the node's bootstrap wallet to mint (or create a mint proposal) and ENS-register the stored draft.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Internal"
                ],
                "summary": "Self mint + ENS register",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.RegistrationStatusResponse"
                        }
                    },
                    "404": {
                        "description": "draft_not_found",
                        "schema": {
                            "$ref": "#/definitions/fiber.Map"
                        }
                    }
                }
            }
        },
        "/internal/authorize": {
            "post": {
                "description": "Resolves the agent identity, fetches OwnerOf(tokenId), compares to the supplied address. Used by gateway during /auth/verify.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Internal"
                ],
                "summary": "Internal authorize",
                "parameters": [
                    {
                        "description": "Address to check",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/requests.AuthorizeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.AuthorizeResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/errors.ValidationError"
                        }
                    },
                    "500": {
                        "description": "authorize_failed",
                        "schema": {
                            "$ref": "#/definitions/fiber.Map"
                        }
                    }
                }
            }
        },
        "/internal/conversations/{conversationId}/messages": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Internal"
                ],
                "summary": "Internal list messages",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Conversation id",
                        "name": "conversationId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.ListConversationMessagesResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/errors.ValidationError"
                        }
                    },
                    "500": {
                        "description": "list_failed",
                        "schema": {
                            "$ref": "#/definitions/fiber.Map"
                        }
                    }
                }
            },
            "post": {
                "description": "Idempotent batch append to the local conversation transcript. Dedup by SHA-512 hash of (role, content, conversationId).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Internal"
                ],
                "summary": "Internal append messages",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Conversation id",
                        "name": "conversationId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Messages",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/requests.AppendConversationMessagesRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.AppendConversationMessagesResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/errors.ValidationError"
                        }
                    },
                    "500": {
                        "description": "append_failed",
                        "schema": {
                            "$ref": "#/definitions/fiber.Map"
                        }
                    }
                }
            }
        },
        "/internal/identity": {
            "get": {
                "description": "Returns the agent's collection address + tokenId + ENS name. 404 when no NFT has been minted yet.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Internal"
                ],
                "summary": "Internal identity lookup",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.GetAgentIdentityResponse"
                        }
                    },
                    "404": {
                        "description": "identity_not_found",
                        "schema": {
                            "$ref": "#/definitions/fiber.Map"
                        }
                    },
                    "500": {
                        "description": "identity_lookup_failed",
                        "schema": {
                            "$ref": "#/definitions/fiber.Map"
                        }
                    }
                }
            }
        },
        "/internal/identity/ens/publish": {
            "post": {
                "description": "Writes the `url` text record for the agent's NFT via AgentEnsRegistry. Requires the NFT to already exist.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Internal"
                ],
                "summary": "Re-publish ENS runtime records",
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "409": {
                        "description": "identity_not_found",
                        "schema": {
                            "$ref": "#/definitions/fiber.Map"
                        }
                    },
                    "500": {
                        "description": "ens_publish_failed",
                        "schema": {
                            "$ref": "#/definitions/fiber.Map"
                        }
                    }
                }
            }
        },
        "/internal/responses": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Internal"
                ],
                "summary": "Internal create response",
                "parameters": [
                    {
                        "description": "Inputs",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/requests.CreateResponseRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.CreateResponseResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/errors.ValidationError"
                        }
                    },
                    "500": {
                        "description": "create_response_failed",
                        "schema": {
                            "$ref": "#/definitions/fiber.Map"
                        }
                    }
                }
            }
        }
    },
