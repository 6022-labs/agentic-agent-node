# --- runtime_host ---
RUNTIME_HOST__API_PORT=5400
RUNTIME_HOST__BODY_LIMIT_BYTES=4194304
RUNTIME_HOST__LISTEN_ADDRESS=

TELEMETRY__ENABLED=false
TELEMETRY__ENDPOINT=
TELEMETRY__INSECURE=
TELEMETRY__NODE_ID=

# --- vault (secrets backend) ---
VAULT__ADDRESS=http://localhost:8200
VAULT__TOKEN=dev-only-root-token
VAULT__KV_V1_MOUNT_PATH=secret

# --- blockchain RPC endpoints (keyed by chain id) ---
BLOCKCHAIN__CHAINS__80002__HTTP_URL=https://polygon-amoy-public.nodies.app
BLOCKCHAIN__CHAINS__84532__HTTP_URL=https://base-sepolia-public.nodies.app

# --- x402 payment facilitators (keyed by CAIP-2 id) ---
PAYMENT__FACILITATORS__80002__BASE_URL=https://x402-amoy.polygon.technology
PAYMENT__FACILITATORS__80002__MAX_TIMEOUT_SECONDS=60
PAYMENT__FACILITATORS__84532__BASE_URL=https://x402.org/facilitator

# --- inference loop ---
INFERENCE_LOOP__MAX_ITERATIONS=10

# --- agent identity (on-chain NFT + ENS) ---
AGENT_IDENTITY__RUNTIME_URL=https://agent.example.com
AGENT_IDENTITY__ENS_BASE_DOMAIN=6022.eth

# --- ipfs ---
IPFS__NODE_HTTP_URL=http://localhost:5001
IPFS__BEARER_TOKEN=

# --- image generation ---
IMAGE_GENERATION__IMAGE_MARK_PATH=./src/runtime_host/images/nft_mark.png

# --- runtime database ---
RUNTIME_DATABASE__DRIVER=postgres
RUNTIME_DATABASE__URL=postgres://agent:agent@localhost:5432/agent?sslmode=disable

# --- runtime migrations ---
RUNTIME_MIGRATIONS__FOLDER_PATH=./src/runtime_db/migrations