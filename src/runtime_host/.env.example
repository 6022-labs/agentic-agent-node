# Runtime host — internal-only runtime + knowledge. Loaded by koanf in
# addition to appsettings.json: env vars override file values when the key
# follows the UPPER_SNAKE pattern with `__` between sections.

RUNTIME_HOST__API_PORT=5001
RUNTIME_HOST__BODY_LIMIT_BYTES=4194304 # Default: 4194304 (4MB)
RUNTIME_HOST__LISTEN_ADDRESS=127.0.0.1  # bind loopback only — gateway is the sole caller

VAULT__ADDRESS=http://localhost:8200
VAULT__TOKEN=
VAULT__KV_V1_MOUNT_PATH=secret

BLOCKCHAIN__ID=
BLOCKCHAIN__RPC_HTTP_URL=

AGENT_IDENTITY_ENS__RUNTIME_URL=  # public URL this agent is reachable at — written to the `agent.runtime-url` ENS text record at boot

RUNTIME_DATABASE__DRIVER=postgres            # postgres | mysql | mariadb
RUNTIME_DATABASE__URL=postgres://agent:agent@localhost:5432/agent_knowledge?sslmode=disable
RUNTIME_MIGRATIONS__FOLDER_PATH=./src/runtime_db/migrations
