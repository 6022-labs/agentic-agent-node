# --- runtime_host ---
RUNTIME_HOST__API_PORT=5400
RUNTIME_HOST__BODY_LIMIT_BYTES=4194304
RUNTIME_HOST__LISTEN_ADDRESS=

TELEMETRY__ENABLED=false
# grpc (default) or http; endpoint stays host:port (collector 4317 for grpc, 4318 for http).
TELEMETRY__PROTOCOL=
TELEMETRY__ENDPOINT=
TELEMETRY__INSECURE=
TELEMETRY__INSTANCE_ID=
TELEMETRY__ENVIRONMENT=
TELEMETRY__AUTH_TOKEN=
TELEMETRY__AUTH_USERNAME=
TELEMETRY__AUTH_PASSWORD=

# --- vault (secrets backend) ---
VAULT__ADDRESS=http://localhost:8200
VAULT__TOKEN=dev-only-root-token
VAULT__KV_V1_MOUNT_PATH=secret

# --- blockchain RPC endpoints (keyed by chain id) ---
BLOCKCHAIN__EVM_CHAINS__80002__HTTP_URL=https://polygon-amoy-public.nodies.app
BLOCKCHAIN__EVM_CHAINS__80002__REQUEST_TIMEOUT_SECONDS=10 # Default: 10
BLOCKCHAIN__EVM_CHAINS__84532__HTTP_URL=https://base-sepolia-public.nodies.app
BLOCKCHAIN__EVM_CHAINS__84532__REQUEST_TIMEOUT_SECONDS=10 # Default: 10

# --- payment receive: x402 facilitators (keyed by chain id) ---
PAYMENT__RECEIVE__FACILITATORS__80002__BASE_URL=https://x402-amoy.polygon.technology
PAYMENT__RECEIVE__FACILITATORS__80002__MAX_TIMEOUT_SECONDS=60 # Default: 60
PAYMENT__RECEIVE__FACILITATORS__84532__BASE_URL=https://x402.org/facilitator

# --- payment spend: signing window (what may be spent lives in spend_rules) ---
PAYMENT__SPEND__VALIDITY_SECONDS=300 # Default: 300
PAYMENT__SPEND__VALID_AFTER_SKEW_SECONDS=60 # Default: 60
PAYMENT__SPEND__FREE_VALIDITY_SECONDS=60 # Default: 60

# --- inference loop ---
INFERENCE_LOOP__MAX_ITERATIONS=10
INFERENCE_LOOP__MAX_DURATION_SECONDS=300
INFERENCE_LOOP__MAX_TOTAL_TOKENS=500000

# --- conversation titler ---
CONVERSATION_TITLER__TIMEOUT_SECONDS=30 # Default: 30

# --- agent to agent ---
A2A__REQUEST_TIMEOUT_SECONDS=120 # Default: 120
A2A__CARD_TIMEOUT_SECONDS=10 # Default: 10
A2A__MAX_RESPONSE_BYTES=65536 # Default: 65536
A2A__ALLOW_PRIVATE_NETWORKS=false # Default: false

# --- agent identity (on-chain NFT + ENS) ---
AGENT_IDENTITY__RUNTIME_URL=https://agent.example.com
AGENT_IDENTITY__ENS_BASE_DOMAIN=6022.eth
AGENT_IDENTITY__IDENTITY_SYNC_INTERVAL_SECONDS=600 # Default: 600

# --- ipfs ---
IPFS__NODE_HTTP_URL=http://localhost:5001
IPFS__BEARER_TOKEN=

# --- image generation ---
IMAGE_GENERATION__IMAGE_MARK_PATH=./src/runtime_host/images/nft_mark.png

# --- runtime database ---
RUNTIME_DATABASE__DRIVER=postgres
RUNTIME_DATABASE__URL=postgres://agent:agent@localhost:5432/agent?sslmode=disable
# PEM CA the server certificate must chain to; set, it forces verified TLS (postgres, mysql, mariadb).
# Default: empty, TLS as the url says
RUNTIME_DATABASE__CA_CERTIFICATE=
# Name the certificate is checked against when it differs from the url host.
# Default: the url host
RUNTIME_DATABASE__TLS_SERVER_NAME=

# --- runtime migrations ---
RUNTIME_MIGRATIONS__FOLDER_PATH=./src/runtime_db/migrations

# --- os ---
OS__WORKDIR=/workspace

# --- commands ---
COMMAND__DEFAULT_TIMEOUT_SECONDS=120
COMMAND__MAX_TIMEOUT_SECONDS=240
COMMAND__DEFAULT_YIELD_SECONDS=30
COMMAND__MAX_OUTPUT_CHARS=30000
COMMAND__MAX_BACKGROUND_PROCESSES=8
COMMAND__MAX_BACKGROUND_SECONDS=1800
COMMAND__FINISHED_RETENTION_SECONDS=600