{
  "runtime_host": {
    "api_port": 5001,
    "app_name": "AgenticAI-Agent-Node-Runtime",
    "body_limit_bytes": 4194304,
    "listen_address": "127.0.0.1"
  },
  "vault": {
    "address": "http://localhost:8200",
    "token": "dev-only-root-token",
    "kv_v1_mount_path": "secret"
  },
  "blockchain": {
    "id": 1,
    "rpc_http_url": "https://eth.llamarpc.com"
  },
  "agent_knowledge_database": {
    "driver": "postgres",
    "url": "postgres://agent:agent@localhost:5432/agent_knowledge?sslmode=disable"
  },
  "agent_knowledge_migrations": {
    "folder_path": "./src/agent_knowledge_db/migrations"
  }
}
