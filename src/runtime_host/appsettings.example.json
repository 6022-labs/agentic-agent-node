{
  "runtime_host": {
    "api_port": 5400,
    "body_limit_bytes": 4194304,
    "listen_address": ""
  },
  "telemetry": {
    "enabled": false,
    "protocol": "grpc",
    "endpoint": "localhost:4317",
    "insecure": true,
    "instance_id": "agent-node-1",
    "environment": "local",
    "auth_token": "",
    "auth_username": "",
    "auth_password": ""
  },
  "vault": {
    "address": "http://localhost:8200",
    "token": "dev-only-root-token",
    "kv_v1_mount_path": "secret"
  },
  "blockchain": {
    "evm_chains": {
      "80002": { "http_url": "https://polygon-amoy-pokt.nodies.app", "request_timeout_seconds": 10 },
      "84532": { "http_url": "https://sepolia.base.org", "request_timeout_seconds": 10 }
    },
    "btc_chains": {
      "network": "mainnet"
    }
  },
  "payment": {
    "receive": {
      "facilitators": {
        "80002": { "base_url": "https://x402-amoy.polygon.technology", "max_timeout_seconds": 60 },
        "84532": { "base_url": "https://x402.org/facilitator" }
      }
    },
    "spend": {
      "validity_seconds": 300,
      "valid_after_skew_seconds": 60,
      "free_validity_seconds": 60
    }
  },
  "inference_loop": {
    "max_iterations": 10,
    "max_duration_seconds": 300,
    "max_total_tokens": 500000
  },
  "a2a": {
    "request_timeout_seconds": 120,
    "card_timeout_seconds": 10,
    "max_response_bytes": 65536,
    "allow_private_networks": false
  },
  "conversation_titler": {
    "timeout_seconds": 30
  },
  "os": {
    "workdir": "/workspace",
    "command_user": ""
  },
  "command": {
    "default_timeout_seconds": 120,
    "max_timeout_seconds": 240,
    "default_yield_seconds": 30,
    "max_output_chars": 30000,
    "max_background_processes": 8,
    "max_background_seconds": 1800,
    "finished_retention_seconds": 600
  },
  "agent_identity": {
    "runtime_url": "https://agent.example.com",
    "ens_base_domain": "6022.eth",
    "identity_sync_interval_seconds": 600
  },
  "ipfs": {
    "node_http_url": "http://localhost:5001",
    "bearer_token": ""
  },
  "image_generation": {
    "image_mark_path": "./src/runtime_host/images/nft_mark.png"
  },
  "runtime_database": {
    "driver": "postgres",
    "url": "postgres://agent:agent@localhost:5432/agent_knowledge?sslmode=disable",
    "ca_certificate": "",
    "tls_server_name": ""
  },
  "runtime_migrations": {
    "folder_path": "./src/runtime_db/migrations"
  }
